# NYAYASHASTRA Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# BACKEND CONFIGURATION
# ============================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Database Configuration
# SQLite (Development)
DATABASE_URL=sqlite:///./nyayguru.db
# PostgreSQL (Production) - Uncomment and configure
# DATABASE_URL=postgresql://user:password@localhost:5432/nyayashastra

DATABASE_ECHO=false

# Vector Database Configuration
CHROMA_PERSIST_DIR=./chroma_db
# Must match the model used at ingestion time (scripts/ingest_statutes.py)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_USE_API=false

# RAG pipeline (hybrid dense + BM25 -> RRF -> rerank -> compressed context)
RAG_COLLECTION=legal_documents_semantic
RAG_DENSE_K=15
RAG_LEXICAL_K=15
RAG_TOP_K=5
RAG_RERANK_CANDIDATES=12
RAG_MIN_RERANK_SCORE=0.15
RAG_CONTEXT_TOKEN_BUDGET=3000
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============================================
# AI/LLM CONFIGURATION
# ============================================
# Runtime generation uses the LOCAL legal SLM via Ollama.
# Build it once: ollama create nyayshastra-legal -f backend/ollama/Modelfile
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nyayshastra-legal
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_TEMPERATURE=0.1
# Cloud LLMs are never used for chat unless this is true AND the local SLM fails
ALLOW_CLOUD_FALLBACK=false

# Optional cloud providers (only used when LLM_PROVIDER is set to one of them,
# or as an explicit fallback with ALLOW_CLOUD_FALLBACK=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# ============================================
# REDIS CACHE (Optional)
# ============================================
REDIS_URL=redis://localhost:6379/0
USE_CACHE=false

# ============================================
# SECURITY
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-minimum-32-characters-required
ALGORITHM=HS256

# ============================================
# DOCUMENT PROCESSING
# ============================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,doc,docx

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Backend API URL
VITE_API_URL=http://localhost:8000

# App Configuration
VITE_APP_NAME=NYAYASHASTRA
VITE_APP_VERSION=1.0.0

# Clerk Authentication
# Get your key from: https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key-here

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# For Production:
# 1. Set API_DEBUG=false
# 2. Use PostgreSQL instead of SQLite
# 3. Set strong SECRET_KEY (min 32 chars)
# 4. Update CORS_ORIGINS with your domain
# 5. Enable Redis caching
# 6. Use production Clerk keys
# 7. Set VITE_API_URL to your backend URL
